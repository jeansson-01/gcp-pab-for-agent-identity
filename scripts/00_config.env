#!/usr/bin/env bash
# ==============================================================================
# GCP Principal Access Boundaries (PAB) Demo - Environment Configuration
# ==============================================================================

# Portable paths for uv, agents-cli, and gcloud across macOS and Linux
export PATH="${HOME}/.local/bin:${HOME}/Downloads/google-cloud-sdk/bin:${HOME}/google-cloud-sdk/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

# Load persistent demo state if available (restores ORG_ID, BILLING_ACCOUNT_ID, DEMO_SUFFIX, etc.)
STATE_FILE="$(dirname "${BASH_SOURCE[0]}")/.demo_state.env"
if [ -f "$STATE_FILE" ]; then
  # shellcheck disable=SC1090
  source "$STATE_FILE"
fi

# Required: Google Cloud Organization ID (numerical ID)
# Inherits from .demo_state.env or shell env; can be overridden or auto-detected
export ORG_ID="${ORG_ID:-}"

# Required: Active Billing Account ID (format: XXXXXX-XXXXXX-XXXXXX)
# Inherits from .demo_state.env or shell env; can be overridden or auto-detected
export BILLING_ACCOUNT_ID="${BILLING_ACCOUNT_ID:-}"

# Region for Agent Runtime and GCS Buckets
export REGION="${REGION:-us-central1}"

# Folder Name specified in demo requirements
export FOLDER_DISPLAY_NAME="my-awesome-PAB-demo"

# Base suffix for unique project and bucket naming
# Ensures persistent suffix across scripts
if [ -z "${DEMO_SUFFIX}" ]; then
  export DEMO_SUFFIX="$(openssl rand -hex 3 2>/dev/null || echo $RANDOM)"
  echo "export DEMO_SUFFIX=${DEMO_SUFFIX}" >> "$STATE_FILE"
fi

# Project IDs
export PROJECT_1_ID="pab-demo-agent-${DEMO_SUFFIX}"
export PROJECT_2_ID="pab-demo-target-${DEMO_SUFFIX}"

# Bucket Names
export BUCKET_P1="pab-p1-data-${DEMO_SUFFIX}"
export BUCKET_P2="pab-p2-confidential-${DEMO_SUFFIX}"

# PAB Policy ID (must be unique within organization)
export PAB_POLICY_ID="pab-agent-containment-${DEMO_SUFFIX}"
export PAB_BINDING_ID="pab-agent-binding-${DEMO_SUFFIX}"

# Agent Runtime Service / ReasoningEngine Display Name
export AGENT_DISPLAY_NAME="pab-storage-inspector"
